# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
Spider_Project_2024/SourceArt/**/*.png
Spider_Project_2024/SourceArt/**/*.tga

# Binary Files
Spider_Project_2024/Binaries/*
Spider_Project_2024/Plugins/**/Binaries/*

# Builds
Spider_Project_2024/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Spider_Project_2024/Build/*/
Spider_Project_2024/Build/*/**
!Spider_Project_2024/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Spider_Project_2024/Build/**/*.ico

# Built data for maps
*Spider_Project_2024/_BuiltData.uasset

# Configuration files generated by the Editor
Spider_Project_2024/Saved/*

# Compiled source files for the engine to use
Spider_Project_2024/Intermediate/*
Spider_Project_2024/Plugins/**/Intermediate/*

# Cache files for the editor to use
Spider_Project_2024/DerivedDataCache/*
